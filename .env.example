# Optional: GitHub API token for more requests
GITHUB_TOKEN=
# Optional: key for /api/ai/* read-only endpoints (generate with Python secrets)
AI_API_KEY=

# v3: automatically discover recent projects daily at 03:00 local time
AUTO_DISCOVER_ENABLED=true
AUTO_DISCOVER_HOUR=3
AUTO_DISCOVER_LIMIT=10
AUTO_DISCOVER_TZ=Europe/Berlin
